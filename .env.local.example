NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# 地図タイル。未設定ならCARTOにフォールバックする。
# ローカル開発では意図的に設定しないこと: 開発中に地図を動かすだけで
# 無料枠を使い切り、本番のアカウントごと停止させた実績がある(2026-08-14)。
# 本番(Vercel)にだけ入れる。
NEXT_PUBLIC_MAPTILER_KEY=your-maptiler-key-here

# OGP・共有リンクの絶対URL解決に使う本番URL(未設定時はhttp://localhost:3000)
NEXT_PUBLIC_SITE_URL=https://cafe-radar.example.com

# Google AdSenseのパブリッシャーID(ca-pub-で始まる文字列)。
# 未設定 or 開発環境では常にプレースホルダー枠を表示する
NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx

# ChargeSPOTのアフィリエイト/計測付きリンク。未設定時は公式サイトへリンクする
NEXT_PUBLIC_CHARGESPOT_URL=https://chargespot.jp/

# 「別の作業場所を探す」導線のアフィリエイトリンク(A8等)。未設定時は
# エリア名でのGoogleマップ検索にフォールバックする。PR表示はURLの有無に
# 関わらず常に出るので、ここを設定してもしなくても法令面の扱いは変わらない
NEXT_PUBLIC_WORKSPACE_AFFILIATE_URL=https://px.a8.net/svt/ejp?a8mat=xxxxxxxx

# 同じA8素材に付いてくる1x1のインプレッション計測gif(任意)。
# 未設定でも成果計測は動くが、入れないと管理画面の表示回数が0のままになる
NEXT_PUBLIC_WORKSPACE_AFFILIATE_IMPRESSION_URL=https://www17.a8.net/0.gif?a8mat=xxxxxxxx

# 広告主の招待メール送信(supabase.auth.admin.inviteUserByEmail)に必要。
# Supabaseダッシュボードの Project Settings > API から取得する「service_role」キー。
# サーバー専用(API Routeでのみ使用)。NEXT_PUBLIC_を絶対に付けないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Googleマップ版の比較ページ(/map-google)用。未設定ならそのページは案内だけ出す。
# 上限は Google Cloud 側で設定すること(1日あたりの地図読み込み回数)。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...
# AdvancedMarkerの描画にMap IDが必要。未設定ならGoogleのデモ用IDで動く
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# 営業時間・定休日を Google から取るための鍵(サーバー側でのみ使う)。
# Google Cloud で「Places API (New)」を有効にした鍵を入れる。
# NEXT_PUBLIC_ が付いていないのは、ブラウザに渡さないため
# (渡すと誰でも使えてしまい、料金がこちらに来る)。
# 未設定なら営業時間の欄が出ないだけで、他はそのまま動く。
GOOGLE_PLACES_API_KEY=

# ── LINE の自動応答 bot (/api/webhook) ──
# 3つとも入っていないと webhook は 503 を返す(他のページには影響しない)。
# いずれも NEXT_PUBLIC_ を付けないこと。アクセストークンが漏れると
# こちらの公式アカウントから誰でもメッセージを送れてしまう。
#
# LINE Developers > Messaging API チャネル > 「Messaging API設定」の
# 「チャネルアクセストークン(長期)」
LINE_CHANNEL_ACCESS_TOKEN=
# 同じチャネルの「チャネル基本設定」にある「チャネルシークレット」。
# webhook が LINE から来たことの確認(署名の照合)に使う
LINE_CHANNEL_SECRET=
# Google AI Studio で発行する Gemini API の鍵。
# 鍵に紐づく Google Cloud プロジェクトで「Generative Language API」を
# 有効にしておくこと(未設定だと 403 SERVICE_DISABLED で返事が作れない)
GEMINI_API_KEY=

# 使うモデル。未設定なら gemini-flash-latest(その時点の最新 flash を指す
# 別名)。速さや値段を変えたいときだけ入れる
GEMINI_MODEL=
# bot の人格・答え方の指示。未設定なら「LINE向けに簡潔・Markdownなし」の
# 既定文が入る。用途を絞りたいときに上書きする
GEMINI_SYSTEM_INSTRUCTION=
